<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Hello Express!</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/table.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        :root{
            --bg:#0f1724; --card:#0b1220; --accent:#7c5cff; --muted:#9aa4b2; --glass: rgba(255,255,255,0.03);
            font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        }
        html,body{height:100%;margin:0}
        h1{margin:0 0 8px 0;font-size:26px;letter-spacing:-0.3px}
        footer{margin-top:18px;color:rgba(255,255,255,0.06);font-size:12px}
    </style>
</head>
<body>
    <div class="header">
        <h1><%= title %></h1>
        <p><%= content %></p>
    </div>
    <div class="add-button-container">
        <a href="/users/add" class="add-button">
            <i class="fa-solid fa-plus"></i> Add New Users
        </a>
    </div>
    <div class="table-container">
        <table>
            <tr><th>No</th> <th>Name</th> <th>Actions</th></tr>
            <% users.forEach(function(user, index){ %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= user.name %></td>
                    <td>
                        <div class="actions">
                            <a href="/users/details/<%= user.id %>" class="btn btn-view" title="View">
                                <i class="fa fa-solid fa-eye"></i>
                            </a>
                            <a href="/users/update/<%= user.id %>" class="btn btn-edit" title="Edit">
                                <i class="fa fa-solid fa-pen"></i>
                            </a>
                            <form action="/users/delete/<%= user.id %>?_method=DELETE" method="POST">
                                <button type="submit" class="btn btn-delete" title="Delete"
                                    onclick="return confirm('Are you sure you want to delete this user?')">
                                    <i class="fa fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            <% }); %>
        </table>
    </div>
</body>
</html>